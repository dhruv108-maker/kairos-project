# Browser-facing API prefix. In development, Vite proxies /api to FastAPI.
VITE_API_BASE_URL=/api/v1

# Set to true only when intentionally using the template's demo mock data.
VITE_USE_MOCKS=false

# Optional Vite development proxy target (FastAPI default: http://127.0.0.1:8000)
KAIROS_API_PROXY_TARGET=http://127.0.0.1:8000

# Backend settings. Replace placeholders in your local, untracked .env file.
APP_NAME=Kairos API
ENVIRONMENT=development
DEBUG=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=replace-with-your-database-password
DB_NAME=kairos
ALEMBIC_DB_DRIVER=pymysql
SQL_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
VPS_STORAGE_PATH=./var/kairos/storage
FRONTEND_URL=http://localhost:5173
JWT_SECRET_KEY=replace-with-a-long-random-secret
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=verify-your-sender-domain@example.com
MAIL_FROM_NAME=Kairos

# Signzy Aadhaar number verification (backend only; disabled until the provider account is approved/configured).
# Obtain the exact product entitlement and current API contract directly from Signzy before enabling.
# Use the preproduction endpoint first; never put these values in VITE_* variables or browser code.
SIGNZY_BASE_URL=https://api-preproduction.signzy.app
SIGNZY_USERNAME=
SIGNZY_PASSWORD=
SIGNZY_AADHAAR_ENABLED=false
IDENTITY_VERIFICATION_PROVIDER=signzy
