# Browser-facing API prefix. In development, Vite proxies /api to FastAPI.
VITE_API_BASE_URL=/api/v1

# Set to true only when intentionally using the template's demo mock data.
VITE_USE_MOCKS=false

# Optional Vite development proxy target (FastAPI default: http://127.0.0.1:8000)
KAIROS_API_PROXY_TARGET=http://127.0.0.1:8000
